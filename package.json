{
  "name": "ha-eufy-sdk-bridge",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Eufy SDK bridge with go2rtc live video, incoming camera audio, and on-demand WebRTC talkback.",
  "main": "server.mjs",
  "bin": {
    "eufy-sdk-bridge": "bin/start.sh"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "use:sdk-beta": "npm install --no-save @mega-yfue/eufy-sdk@beta",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@mega-yfue/eufy-sdk": "0.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
